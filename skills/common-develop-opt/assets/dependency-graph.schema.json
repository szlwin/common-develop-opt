{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:common-develop-opt:dependency-graph",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "artifactId"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "$ref": "urn:common-develop-opt:artifact-identity#/$defs/kind"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "from",
          "to",
          "kind"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "not": {
                    "enum": [
                      "contextual",
                      "supersedes"
                    ]
                  }
                }
              }
            },
            "then": {
              "required": [
                "revision",
                "contentDigest"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "nodes",
    "edges"
  ]
}
