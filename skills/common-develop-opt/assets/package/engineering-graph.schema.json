{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common-develop.local/schema/engineering-graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authority",
    "kind",
    "nodes",
    "relationships"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "authority": {
      "const": "DERIVED"
    },
    "kind": {
      "const": "engineering_knowledge_graph"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "name",
          "sourceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contextRef": {
            "type": "string"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "type",
          "reason",
          "sourceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "propagation": {
            "enum": [
              "DEFAULT",
              "BOUNDARY",
              "CONDITIONAL",
              "NO_PROPAGATION"
            ]
          }
        }
      }
    }
  }
}
