{
  "schemaVersion": 1,
  "answerOptions": [
    "YES",
    "NO",
    "UNKNOWN",
    "NOT_APPLICABLE"
  ],
  "principles": [
    "三种输入模式必须进入同一 submit 门禁。",
    "Agent 草稿不得由同一 Agent 直接确认。",
    "用户只回答检查项；revision、criterion、scope、evidence digest 和时间由脚本生成。",
    "没有适用证据时不得形成 PASSED。",
    "NO 生成 NEEDS_CHANGES；UNKNOWN 生成 BLOCKED；全部 YES 才可 PASSED。"
  ],
  "defaultGuide": {
    "title": "专业 Review",
    "questions": [
      {
        "id": "SCOPE",
        "text": "本次变更的职责、范围和边界是否清楚且一致？",
        "criterionPrefixes": [
          "RC-REQ",
          "RC-ANL",
          "RC-BM",
          "RC-DES",
          "RC-ARCH",
          "RC-PLAN",
          "RC-SPEC",
          "RC-ENG"
        ]
      },
      {
        "id": "RISK",
        "text": "关键规则、异常路径和主要风险是否已覆盖？",
        "criterionPrefixes": [
          "RC-SEC",
          "RC-PERF",
          "RC-CONC",
          "RC-MIG",
          "RC-IMP",
          "RC-XMOD"
        ]
      },
      {
        "id": "VERIFY",
        "text": "验收、测试和证据是否足以支持当前结论？",
        "criterionPrefixes": [
          "RC-TEST",
          "RC-TDD",
          "RC-EVID",
          "RC-ACPT",
          "RC-API"
        ]
      }
    ]
  },
