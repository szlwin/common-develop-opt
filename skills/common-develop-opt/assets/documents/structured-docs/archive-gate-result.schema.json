{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common-develop/archive-gate-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "archiveId",
    "status",
    "verifiedAt",
    "resultDigest",
    "archiveGate"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "archiveId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "PASSED"
    },
    "verifiedAt": {
      "type": "string",
      "minLength": 1
    },
    "resultDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "archiveGate": {
      "type": "object"
    }
  }
}
