    "all references",
    "entire work_record.md",
    "all task attempts",
    "historical HTML copies",
    "unrelated project versions",
    "entire git_checkpoints.yaml history",
    "entire evidence/registry.jsonl",
    "entire reviews.jsonl history",
    "all evidence snapshot sha256 objects",
    "generated task cache histories",
    "entire evidence/reviews.jsonl history",
    "superseded development task-plan revisions",
    "entire assets/runtime/runtime-contract.json",
    "entire assets/review/review-contract.json",
    "entire context-routing.json"
  ],
  "rule": "This file contains pointers only and must not redefine lifecycle, statuses, Agents, reviewers, work modes, or permissions.",
  "bootstrapCommand": "python3 scripts/wk.py begin",
  "skillImplementationReadPolicy": {
    "default": "FORBIDDEN",
    "scope": "normal_project_work",
    "purpose": "Use the Skill through its resolved context, References, and declared CLI interfaces without loading Skill implementation source.",
    "allowedInputs": [
      "wk begin or on-demand ai_context resolve output",
      "resolved Reference resources",
      "CLI help/query output",
      "validator or command output",
      "project facts and project source code"
    ],
    "forbiddenGlobs": [
      "scripts/*.py",
      "scripts/**/*.py",
      "scripts/_core/**",
      "scripts/runtime/**"
    ],
    "entrypointPolicy": {
      "scripts/design_doc.py": "EXECUTE_ONLY",
      "scripts/case_doc.py": "EXECUTE_ONLY",
      "scripts/_core/document_utils.py": "INTERNAL_IMPLEMENTATION_FORBIDDEN"
    },
    "interfaceDiscovery": "Use wk.py help, cli_help.py, or the command's --help/query output; do not inspect Python source to discover parameters or behavior.",
    "exceptions": [
      "skill_maintenance",
      "cli_failure_diagnosis",
      "skill_implementation_review",
      "explicit_user_request"
    ],
    "exceptionRule": "An exception must be explicit in the task context; it does not apply to ordinary requirement, design, planning, development, review, or testing work."
  }
}
