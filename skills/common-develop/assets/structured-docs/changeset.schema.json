{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common-develop/changeset.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeSet", "operations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "changeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "module", "featureCode", "reason", "baseRevisions", "resultRevisions", "affectedTraceIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "module": {"type": "string", "minLength": 1},
        "featureCode": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "baseRevisions": {"$ref": "#/$defs/revisionMap"},
        "resultRevisions": {"$ref": "#/$defs/revisionMap"},
        "affectedTraceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "operation", "targetId", "reason"],
        "properties": {
          "artifact": {"enum": ["business_model", "api", "db"]},
          "operation": {"enum": ["add", "update", "deprecate"]},
          "targetId": {"type": "string", "minLength": 1},
          "beforeRef": {"type": "string"},
          "after": {"type": "object"},
          "reason": {"type": "string", "minLength": 1},
          "collection": {
            "enum": ["terms", "scenarios", "entities", "valueObjects", "aggregates", "invariants", "stateMachines", "services", "policies", "events", "businessErrors", "traceability", "endpoints", "tables"]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"operation": {"enum": ["add", "update"]}}},
            "then": {"required": ["after"]}
          }
        ]
      }
    }
  },
  "$defs": {
    "revisionMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}
