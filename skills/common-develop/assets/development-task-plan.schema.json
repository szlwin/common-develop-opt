{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common-develop/development-task-plan.schema.json",
  "title": "Common Develop Large Requirement Development Task Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "target_id",
    "version",
    "status",
    "revision",
    "revision_no",
    "input_revisions",
    "work_mode",
    "execution_mode",
    "generated_by_agent",
    "required_reviewers",
    "review_round",
    "tasks"
  ],
  "properties": {
    "implementation_strategy_contract_version": {
      "const": 1,
      "description": "Required on every canonical task plan."
    },
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^TP-[A-Z0-9_.-]+$"
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PENDING",
        "IN_REVIEW",
        "REWORK",
        "BLOCKED",
        "PASSED"
      ]
    },
    "revision": {
      "type": "string"
    },
    "revision_no": {
      "type": "integer",
      "minimum": 0
    },
    "supersedes_revision": {
      "type": "string"
    },
    "revision_reason": {
      "type": "string"
    },
    "input_revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_analysis",
        "business_model",
        "design",
        "test_design"
      ],
      "properties": {
        "requirement_analysis": {
          "type": "string",
          "minLength": 1
        },
        "business_model": {
          "type": "string",
          "minLength": 1
        },
        "design": {
          "type": "string",
          "minLength": 1
        },
        "test_design": {
          "type": "string"
        }
      }
    },
    "work_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimal",
        "architecture_review"
      ],
      "properties": {
        "minimal": {
          "type": "boolean"
        },
        "architecture_review": {
          "type": "boolean"
        }
      }
    },
    "execution_mode": {
      "const": "SEQUENTIAL"
    },
    "generated_by_agent": {
      "const": "ImplementationPlanAgent"
    },
    "required_reviewers": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z]+Agent$"
      }
    },
    "review_round": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "finalized_at": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "title",
        "goal",
        "implementation",
        "acceptance_criteria",
        "depends_on",
        "owner_agent",
        "reviewer_agents",
        "validation_commands",
        "expected_results",
        "deliverables",
        "stop_conditions",
        "trace_ids",
        "git_checkpoint_required"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^TASK-[A-Z0-9_.-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 4
        },
        "goal": {
          "type": "string",
          "minLength": 12
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner_module",
            "owner_component",
            "steps",
            "affected_files",
            "forbidden_changes"
          ],
          "properties": {
            "owner_module": {
              "type": "string",
              "minLength": 1
            },
            "owner_component": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "affected_files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "forbidden_changes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "implementation_decision_ref": {
              "type": "string",
              "pattern": "IMPL-DEC-[A-Z0-9_-]+"
            },
            "strategy": {
              "enum": [
                "REUSE",
                "COMPATIBLE_EXTEND",
                "MODIFY",
                "CREATE"
              ]
            },
            "existing_code_refs": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "shared_logic_disposition": {
              "enum": [
                "REUSE_SHARED",
                "EXTRACT_EXISTING",
                "EXTRACT_NEW",
                "KEEP_LOCAL",
                "SEPARATE_REFACTOR"
              ]
            },
            "shared_logic_owner": {
              "type": "string",
              "minLength": 1
            },
            "compatibility_verifications": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "source_doc_refs": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "assertion"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "assertion": {
                "type": "string",
                "minLength": 12
              }
            }
          }
        },
        "owner_agent": {
          "const": "DevelopAgent"
        },
        "reviewer_agents": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z]+Agent$"
          }
        },
        "validation_commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trace_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "flow_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "flow_step_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "risk_triggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "git_checkpoint_required": {
          "const": true
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
