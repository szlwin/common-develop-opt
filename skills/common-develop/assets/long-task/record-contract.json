  "workRecordSchemaVersion": 4,
  "storagePolicy": {
    "taskState": "Pure ignored cache at cache/current_manifest.json; current runtime is deterministically reduced from task_events.jsonl.",
    "instanceTemplates": "Generated task instances contain data blocks only; field explanations remain in record-contract and References.",
    "handoff": "Current handoff is derived from verification/context; handoff/*.md is optional explicit audit history only.",
    "resumeContext": "cache/resume_context.md is ignored derived output.",
    "gitCheckpoint": "git_checkpoints.yaml is created only when wk -gc creates or records the first checkpoint.",
    "taskPlan": "Static execution specification only; runtime status, attempt count, output revision and validation evidence live in task_events.jsonl. Iteration-scoped max_attempts policy overrides also live in task_events.jsonl and never mutate task_plan.json.",
    "reviewIssues": "Issue lifecycle is canonical in task_events.jsonl.",
    "riskReviewerRegistration": "additional_reviewers is risk audit metadata, not a disjoint identity set. A current risk-backed entry may name an already required or conditional Reviewer only when reviewer, trigger, development revision, and complete evidence IDs exactly match risk.json; all other overlaps fail closed.",
    "artifactRetention": "Keep one canonical current requirement/design fact file. Preserve revisions through Git refs, Evidence, Review, and task events; do not create per-round fact copies or ad-hoc command-output trees. Prefer GIT_REF, then one multi-use content-addressed bundle, and treat cache as disposable."
  },
  "autoEvidencePolicy": {
    "commandResultSchemaVersion": 2,
    "commandSource": "task_plan.json.tasks[].validation_commands",
    "exactMatchRequired": true,
    "attemptBinding": ["current phase", "output revision", "task attempt"],
    "failureIsNotCompletion": true,
    "reviewerEvidenceSeparate": true,
    "stderrCapture": "finish-attempt --auto-evidence stores stderr separately when present",
    "timeoutSeconds": 300,
    "timeoutAuditFields": ["timeout_seconds", "duration_ms", "completed_at", "status", "error_code"],
    "timeoutErrorCode": "COMMAND_TIMEOUT",
    "timeoutLifecycleEvent": "ATTEMPT_COMMAND_RECORDED",
    "reference": "references/long-task-core.md#自动验证证据"
  },
  "taskEventPolicy": {
    "file": "task_events.jsonl",
    "schemaVersion": 1,
    "canonicalFor": [
      "taskStateRuntime",
      "taskRuntime",
      "taskAttempt",
      "stageOutcome",
      "staleEvent",
      "autoRemediationEvent",
      "issueLifecycle",
      "taskPolicy",
      "authorizationBatch",
      "authorizationConsumption",
      "artifactAmendment",
      "traceabilityRevalidation"
    ],
    "derivedManifest": "cache/current_manifest.json",
    "appendOnly": true,
    "hashChain": true,
    "eventTypes": [
      "TASK_STATE_PATCHED",
      "TASK_REDUCER_SNAPSHOT",
      "TASK_RUNTIME_SET",
      "ATTEMPT_STARTED",
      "ATTEMPT_COMMAND_RECORDED",
      "ATTEMPT_FINISHED",
      "ATTEMPT_CANCELLED",
      "STAGE_OUTCOME_PUBLISHED",
      "STAGE_OUTCOME_FINALIZED",
      "STAGE_OUTCOME_SUPERSEDED",
      "STAGE_OUTCOME_RECORDED",
      "PHASE_STALE",
      "ARTIFACT_AMENDED",
      "AUTO_REMEDIATION_DECISION",
      "AUTO_REMEDIATION_CONVERGENCE",
      "ISSUE_OPENED",
      "ISSUE_ASSIGNED",
      "ISSUE_REMEDIATED",
      "ISSUE_VERIFIED",
      "ISSUE_CLOSED",
      "ISSUE_DEFERRED",
      "ISSUE_REOPENED",
      "ISSUE_REJECTED",
      "TASK_POLICY_SET",
      "AUTHORIZATION_BATCH_CONFIRMED",
      "AUTHORIZATION_BATCH_CONSUMED",
      "TRACEABILITY_REVALIDATED"
    ]
  }
