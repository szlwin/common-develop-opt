{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common-develop.local/schemas/project-constraints.schema.json",
  "title": "common-develop project constraints block",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "constraints"
  ],
  "properties": {
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    }
  },
  "$defs": {
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "statement",
        "owner",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_.-]+$"
        },
        "type": {
          "enum": [
            "HARD",
            "SOFT",
            "ASSUMPTION"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "validation": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "decisionRef": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "UNVALIDATED",
            "VALIDATED",
            "INVALIDATED",
            "WAIVED"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "verificationTask": {
          "type": "string",
          "minLength": 1
        },
        "validationRef": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
